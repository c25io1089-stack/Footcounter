# PostgreSQL холболт (Railway дээр Postgres нэмэхэд автоматаар DATABASE_URL өгнө)
DATABASE_URL=postgres://hx:hx@localhost:5432/hxccd
# Cookie нэвтрэлтийн нууц (урт санамсаргүй тэмдэгт мөр)
JWT_SECRET=change-me-to-a-long-random-string
# Анхны superadmin (зөвхөн DB хоосон үед үүснэ)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
PORT=3000
NODE_ENV=production
